# Runtime mode. `mock` is the default contributor experience and requires no credentials.
NEXT_PUBLIC_ESCROW_MODE=mock

# Trustless Work API — only required for testnet mode.
NEXT_PUBLIC_API_KEY=

# Network/provider configuration
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_USE_MAINNET=false

# Workspace/platform values used when creating real escrows.
NEXT_PUBLIC_PLATFORM_ADDRESS=
NEXT_PUBLIC_DISPUTE_RESOLVER_ADDRESS=
NEXT_PUBLIC_USDC_ISSUER=

# Wallet mock remains available until the real Stellar Wallets Kit provider is enabled.
NEXT_PUBLIC_MOCK_WALLET=true
