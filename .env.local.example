# ---------------------------------------------------------------------------
# Agency Escrow Template — environment
# ---------------------------------------------------------------------------
# Copy to `.env.local`. Mock mode (the default) needs NONE of the testnet
# values below: no API key, no wallet, no addresses.
# ---------------------------------------------------------------------------

# Runtime mode: `mock` (default contributor experience) or `testnet`.
NEXT_PUBLIC_ESCROW_MODE=mock

# --- Testnet mode only (ignored in mock mode) ------------------------------
# All of the values below are REQUIRED when NEXT_PUBLIC_ESCROW_MODE=testnet.
# Config is validated at the boundary and fails fast if anything is missing.

# Trustless Work testnet API key (browser-exposed — see docs/TESTNET-INTEGRATION.md
# "API key exposure"). This is a testnet key; NEXT_PUBLIC_* is NOT a secret.
NEXT_PUBLIC_API_KEY=

# Network source of truth. V1 is TESTNET only; mainnet is out of scope and the
# app fails fast if this is set to "true". Keep it false.
NEXT_PUBLIC_USE_MAINNET=false

# Platform + dispute-resolver Stellar addresses (G...). No fake fallbacks are
# used in testnet mode — these must be real, valid G-addresses.
NEXT_PUBLIC_PLATFORM_ADDRESS=
NEXT_PUBLIC_DISPUTE_RESOLVER_ADDRESS=

# Testnet USDC issuer. MUST be the G-issuer address of the asset, NEVER a
# C... Soroban contract address. Used for the escrow trustline object.
NEXT_PUBLIC_USDC_ISSUER=
